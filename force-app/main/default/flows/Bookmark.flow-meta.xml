<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>ResultMessage</name>
        <dataType>String</dataType>
        <expression>IF({!Create_Bookmark.alreadyBookmarked}, &quot;You already bookmarked this candidate. Your existing notes were kept.&quot;, &quot;Bookmark created.&quot;)</expression>
    </formulas>
    <interviewLabel>Bookmark {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bookmark</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <description>Bookmark this candidate for this role. Your notes will be saved on the bookmark</description>
        <name>Add_Notes</name>
        <label>Add Notes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Create_Bookmark</targetReference>
        </connector>
        <fields>
            <name>Display_1</name>
            <fieldText>&lt;p&gt;Bookmark this candidate for this role. Your notes will be saved on the bookmark&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Notes</name>
            <fieldText>Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Result</name>
        <label>Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Display_2</name>
            <fieldText>&lt;p&gt;{!ResultMessage}&lt;/p&gt;&lt;p&gt;{!BookmarkLink}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Add_Notes</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Create_Bookmark</name>
        <label>Create Bookmark</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Result</targetReference>
        </connector>
        <flowName>Create_Bookmark</flowName>
        <inputAssignments>
            <name>jobApplicantId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>notes</name>
            <value>
                <elementReference>Notes</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <textTemplates>
        <name>BookmarkLink</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;a href=&quot;/{!Create_Bookmark.bookmarkId}&quot; target=&quot;_self&quot;&gt;Open bookmark&lt;/a&gt;</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
